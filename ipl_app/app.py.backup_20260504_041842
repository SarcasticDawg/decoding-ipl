# ── Match index (built once from README) ─────────────────────────────────────
def _build_index():
    index = []
    if not README.exists():
        return index
    with open(README) as f:
        for line in f:
            m = re.match(r"(\d{4}-\d{2}-\d{2}) - \w+ - IPL - \w+ - (\d+) - (.+)", line)
            if m:
                date, mid, teams_str = m.group(1), m.group(2), m.group(3).strip()
                parts = teams_str.split(" vs ", 1)
                index.append({
                    "id":    mid,
                    "date":  date,
                    "year":  date[:4],
                    "team1": parts[0].strip(),
                    "team2": parts[1].strip() if len(parts) > 1 else "",
                })
    return index

MATCH_INDEX = _build_index()
BY_YEAR = {}
for m in MATCH_INDEX:
    BY_YEAR.setdefault(m["year"], []).append(m)

@dataclass
class MatchState:
    innings: int
    batting_team: str
    bowling_team: str
    runs: int
    wickets: int
    balls: int
    target: int | None = None

    @property
    def balls_remaining(self):
        return max(0, 120 - self.balls)

    @property
    def wickets_in_hand(self):
        return max(0, 10 - self.wickets)

    @property
    def crr(self):
        return self.runs * 6 / self.balls if self.balls else 0.0

    @property
    def runs_remaining(self):
        if self.target is None:
            return None
        return max(0, self.target - self.runs)

    @property
    def rrr(self):
        if self.target is None:
            return 0.0
        if self.runs >= self.target:
            return 0.0
        return self.runs_remaining * 6 / self.balls_remaining if self.balls_remaining else 99.0

def _sigmoid(x):
    return 1.0 / (1.0 + math.exp(-max(-30.0, min(30.0, x))))

def _phase(ball_number):
    over = ball_number / 6
    if over < 6:
        return "powerplay"
    if over < 15:
        return "middle"
    return "death"

def _is_legal_ball(ball):
    return "wides" not in ball.get("extras", {})

def _wicket_count(ball):
    wickets = ball.get("wickets")
    if isinstance(wickets, list):
        return len(wickets)
    return 1 if ball.get("wicket") else 0

def _wicket_entries(ball):
    wickets = ball.get("wickets")
    if isinstance(wickets, list):
        return wickets
    wicket = ball.get("wicket")
    return [wicket] if wicket else []

def _player_team(players_map, name):
    for team, players in players_map.items():
        if name in players:
            return team
    return ""

def pressure_index(state):
    """Normalized 0..1 pressure with smooth logistic scaling."""
    wicket_stress = 1 - (state.wickets_in_hand / 10)
    ball_stress = 1 - (state.balls_remaining / 120)
    if state.target is None:
        scoring_stress = max(0.0, min(2.0, (8.5 - state.crr) / 8.5))
    else:
        scoring_stress = max(0.0, min(3.0, state.rrr / max(state.crr, 1.0) - 1))
    raw = 1.30 * scoring_stress + 0.85 * wicket_stress + 0.55 * ball_stress - 0.75
    return round(_sigmoid(raw), 4)

def win_probability(state):
    """
    Explainable logistic baseline. Returns probability that the current
    batting team wins, or reaches a winning first-innings total.
    """
    if state.wickets >= 10:
        return 0.01
    if state.target is not None and state.runs >= state.target:
        return 0.99
    if state.target is not None and state.balls_remaining <= 0:
        return 0.99 if state.runs >= state.target else 0.01

    if state.target is None:
        projected = state.runs + state.crr * state.balls_remaining / 6
        wicket_factor = (state.wickets_in_hand - 5) / 5
        phase_factor = (state.balls / 120) - 0.5
        z = -0.10 + 0.030 * (projected - 170) + 0.70 * wicket_factor + 0.25 * phase_factor
    else:
        rr_gap = state.crr - state.rrr
        wickets = state.wickets_in_hand
        resource = state.balls_remaining / 120
        runs_left = state.runs_remaining or 0
        z = 0.15 + 0.36 * rr_gap + 0.28 * (wickets - 5) + 1.10 * resource - 0.018 * runs_left
    return round(max(0.01, min(0.99, _sigmoid(z))), 4)

def _flatten_deliveries(innings_raw):
    innings = []
    for idx, inn_block in enumerate(innings_raw):
        for _, inn_data in inn_block.items():
            rows = []
            for delivery in inn_data.get("deliveries", []):
                for ball_id, ball in delivery.items():
                    rows.append((ball_id, ball))
            innings.append({"index": idx + 1, "team": inn_data.get("team", ""), "deliveries": rows})
    return innings

